# PostgreSQL connection string used by Prisma (prisma/schema.prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public base URL used in magic-link emails (app/api/auth/magic-link/route.ts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend API key for magic-link emails (app/api/auth/magic-link/route.ts)
RESEND_API_KEY=""

# Twilio credentials for phone OTP (app/api/auth/phone-number/route.ts)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
