generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String?
  email              String?  @unique
  phoneNumber        String?  @unique
  lastVerificationId String?
  isVerfied          Boolean? @default(false)
  // orders             Order[]
  // sessions           Session[]
}

model VerificationToken {
  id          String   @id @default(cuid())
  email       String?
  phoneNumber String?
  token       String   @unique
  expires     DateTime

  @@unique([email, phoneNumber, token])
}

